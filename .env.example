# Copy to .env.local for development, and set these as environment variables
# on your host for production.

# Signing key for the session JWT. REQUIRED in production — the server refuses
# to start signing sessions without it. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Directory for the SQLite database file (lqk.db). In production, point this at
# a mounted persistent volume so data survives restarts/redeploys.
# Local dev can leave this unset (defaults to ./data).
LQK_DATA_DIR=/data

# The public origin the portal is reachable at, with no trailing slash. Used
# wherever a link has to be resolved by something OUTSIDE this process and so
# cannot be relative: password-reset emails, QR posters, event invitations, and
# every OAuth redirect URI. Defaults to https://teachers.littlequrankids.sg.
# SET THIS on any deploy that is not the live domain, or reset emails will send
# people to production.
LQK_PUBLIC_BASE_URL=

# Shared code that lets someone register with the HQ branch, which grants the
# admin role. Hand it only to HQ staff; anyone else registers as a teacher at a
# teaching branch. If this is unset, HQ sign-up is refused outright rather than
# granted freely — so production MUST set it before HQ staff can sign up.
# There is no rate limiting on the register endpoint, so make it long and random:
#   node -e "console.log(require('node:crypto').randomBytes(12).toString('base64url'))"
LQK_HQ_CODE=

# Google Sheet backend for the Quran tracker (student roster + lessons), via its
# Apps Script web app. Defaults to the existing values if unset, but set these
# in production and rotate the token in the Apps Script (it has been public).
LQK_SHEET_URL=
LQK_SHEET_TOKEN=

# ── Halaqah Notebook (/notebook) ─────────────────────────────────────────────
# Both keys are OPTIONAL. Typed notes work with neither; each feature simply
# shows as "off" in the UI until its key is present. No audio or image is ever
# written to disk — uploads are streamed to the provider and discarded.

# Groq — transcribes recordings (Whisper) and writes the summaries.
# Free tier at time of writing: 2,000 transcriptions and 28,800 audio-seconds
# (8 hours) per day, which comfortably covers a centre of ~40 teachers.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — reads text out of a photographed page. Only needed for the
# "Photo" capture mode; Groq has no production vision model.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides — leave unset to use the free-tier defaults above.
# LQK_AI_TRANSCRIBE_MODEL=whisper-large-v3
# LQK_AI_CHAT_MODEL=llama-3.3-70b-versatile
# LQK_AI_VISION_MODEL=gemini-flash-latest
#   Use the rolling "-latest" alias, not a pinned version. Google retires
#   specific Gemini versions for NEW API keys while still listing them on
#   /v1beta/models, so a pinned name like gemini-2.5-flash returns 404
#   ("no longer available to new users") on a freshly created key.

# ── Event invitations (/events, /i/<token>) ──────────────────────────────────

# Family photos (and any "Photo upload" custom question) are written straight
# into Karim's Drive folder through an Apps Script web app — see the setup steps
# at the top of scripts/drive-upload.gs. WITHOUT BOTH of these the invitation
# still takes replies, but every photo upload is refused: the event editor says
# "Drive not configured" next to the "Ask guests for a family photo" switch, and
# the guest is told the image didn't upload.
#   LQK_DRIVE_URL   — the Apps Script deployment's /exec URL
#   LQK_DRIVE_TOKEN — must equal SHARED_TOKEN in the script's Script Properties
LQK_DRIVE_URL=
LQK_DRIVE_TOKEN=

# Destination folder. Sent on every request and beats the script's own
# FOLDER_ID, so the live destination is changed HERE, not in the Apps Script.
# Also what the event page's "photos" tile links to.
LQK_DRIVE_FOLDER_ID=

# Signing secret for the store's "Order payment" webhook, from the LQK Shopify
# admin (Settings → Notifications → Webhooks). Without it the endpoint answers
# 503, no contribution is ever confirmed, and an attending family that has paid
# can never finish their reply. The event editor warns about this out loud.
SHOPIFY_EVENTS_WEBHOOK_SECRET=

# The storefront the contribution product is read from and checked out on.
# Defaults to https://lqkstore.littlequrankids.sg when unset.
LQK_STORE_ORIGIN=

# ── Password reset & outbound email ──────────────────────────────────────────
# Resend's HTTPS API is the only mail transport — Railway blocks outbound SMTP,
# so nodemailer cannot work here (see lib/mail.js).
#
# WITHOUT RESEND_API_KEY the "Forgot password?" page tells people to ask an
# admin instead of pretending to send a link, and event invitations can't be
# emailed at all. The sending domain must be verified in the Resend dashboard,
# or every message is rejected.
#   https://resend.com/api-keys
RESEND_API_KEY=

# The From address. Must be on a domain verified in Resend.
# Defaults to "Little Quran Kids <no-reply@littlequrankids.sg>".
MAIL_FROM=

# ── Social sign-in (Google / Apple / Microsoft) ──────────────────────────────
# ALL OPTIONAL, and independent of each other. A provider whose variables are
# unset is not offered on the login page at all — no button, no half-working
# flow. Set Google's pair and only the Google button appears.
#
# Signing in with any of these NEVER creates an account: it finds an existing
# profile or refuses. New staff still register (or are invited) as they do now.
# A teacher whose provider address isn't their work email — a personal Gmail, an
# Apple "Hide My Email" relay — signs in with their password once and connects
# the account under Profile → Connected accounts.
#
# Every provider's redirect URI is:
#   <LQK_PUBLIC_BASE_URL>/api/auth/<provider>/callback
# e.g. https://teachers.littlequrankids.sg/api/auth/google/callback
# Register that EXACT string with the provider — they all match it literally.

# Google — free. Google Cloud console → APIs & Services → Credentials →
# "OAuth client ID" → Web application. Add the redirect URI above.
#   https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft — free. Entra admin centre → App registrations → New registration,
# with a "Web" redirect URI as above. The secret is under Certificates & secrets
# (note its expiry — Entra secrets expire, and sign-in stops dead when they do).
#   https://entra.microsoft.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Which directory may sign in. Defaults to "common" (any Microsoft account).
#
# ⚠️ SECURITY: on "common"/"organizations"/"consumers" the id_token can be signed
# by a directory an attacker controls, so its email claim proves nothing and is
# NOT used to match a portal account (the "nOAuth" pattern). Those users can
# still sign in, but only after connecting Microsoft from their profile page.
# Set this to the LQK tenant id or domain to make Microsoft email matching work.
MICROSOFT_TENANT=

# Apple — needs a PAID Apple Developer account ($99/yr). Four values, from
# https://developer.apple.com/account/resources :
#   APPLE_CLIENT_ID   — the SERVICES ID (e.g. sg.littlequrankids.teachers.web),
#                       NOT the app bundle id. Configure "Sign in with Apple" on
#                       it: domain = the host in LQK_PUBLIC_BASE_URL, return URL
#                       = the callback above.
#   APPLE_TEAM_ID     — the 10-character team id, top right of the portal.
#   APPLE_KEY_ID      — id of a Key with "Sign in with Apple" enabled.
#   APPLE_PRIVATE_KEY — the contents of that key's .p8 file. Downloadable ONCE.
#                       Paste it on one line with literal \n for the newlines:
#                       "-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
#
# Apple only accepts an HTTPS return URL and posts its result back cross-site,
# so Apple sign-in cannot be exercised over plain http on localhost.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
