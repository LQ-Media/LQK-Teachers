# Copy to .env.local for development, and set these as environment variables
# on your host for production.

# Signing key for the session JWT. REQUIRED in production — the server refuses
# to start signing sessions without it. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Directory for the SQLite database file (lqk.db). In production, point this at
# a mounted persistent volume so data survives restarts/redeploys.
# Local dev can leave this unset (defaults to ./data).
LQK_DATA_DIR=/data

# Shared code that lets someone register with the HQ branch, which grants the
# admin role. Hand it only to HQ staff; anyone else registers as a teacher at a
# teaching branch. If this is unset, HQ sign-up is refused outright rather than
# granted freely — so production MUST set it before HQ staff can sign up.
# There is no rate limiting on the register endpoint, so make it long and random:
#   node -e "console.log(require('node:crypto').randomBytes(12).toString('base64url'))"
LQK_HQ_CODE=

# Google Sheet backend for the Quran tracker (student roster + lessons), via its
# Apps Script web app. Defaults to the existing values if unset, but set these
# in production and rotate the token in the Apps Script (it has been public).
LQK_SHEET_URL=
LQK_SHEET_TOKEN=

# ── Halaqah Notebook (/notebook) ─────────────────────────────────────────────
# Both keys are OPTIONAL. Typed notes work with neither; each feature simply
# shows as "off" in the UI until its key is present. No audio or image is ever
# written to disk — uploads are streamed to the provider and discarded.

# Groq — transcribes recordings (Whisper) and writes the summaries.
# Free tier at time of writing: 2,000 transcriptions and 28,800 audio-seconds
# (8 hours) per day, which comfortably covers a centre of ~40 teachers.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — reads text out of a photographed page. Only needed for the
# "Photo" capture mode; Groq has no production vision model.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides — leave unset to use the free-tier defaults above.
# LQK_AI_TRANSCRIBE_MODEL=whisper-large-v3
# LQK_AI_CHAT_MODEL=llama-3.3-70b-versatile
# LQK_AI_VISION_MODEL=gemini-flash-latest
#   Use the rolling "-latest" alias, not a pinned version. Google retires
#   specific Gemini versions for NEW API keys while still listing them on
#   /v1beta/models, so a pinned name like gemini-2.5-flash returns 404
#   ("no longer available to new users") on a freshly created key.

# ── Event invites (/events) ──────────────────────────────────────────────────
# The invite sender is off until these are set. It still builds and previews
# invites without them; only sending fails, and the page says so up front.

# Public origin used for invite links and for the images embedded in emails.
# Must be the address parents can actually reach. Defaults to the Railway
# domain, then to https://teachers.littlequrankids.sg.
APP_URL=https://teachers.littlequrankids.sg

# Email — Google Workspace SMTP.
# SMTP_PASSWORD must be an APP PASSWORD, not the account password: turn on
# 2-Step Verification for the sending account, then generate one at
# https://myaccount.google.com/apppasswords. Workspace caps sending at roughly
# 2,000 recipients/day, so a very large parent list may need splitting.
SMTP_USER=
SMTP_PASSWORD=
# Optional — default to smtp.gmail.com:465 and to sending as SMTP_USER.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=events@littlequrankids.sg
# SMTP_FROM_NAME=Little Quran Kids
# SMTP_REPLY_TO=

# WhatsApp — WATI.
# Copy the endpoint and token from the API Docs page in your WATI dashboard.
# The endpoint looks like https://live-mt-server.wati.io/<tenant-id>.
# WATI_TEMPLATE_NAME must be a template you created in WATI and Meta approved;
# docs/EVENTS.md has the exact wording to submit and the parameter order.
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=
WATI_TEMPLATE_NAME=

# A WhatsApp template's wording is fixed when Meta approves it — it is NOT
# translated at send time. So each language you actually send in needs its own
# approved template named here. Anything unset falls back to WATI_TEMPLATE_NAME
# above, and the builder warns you before a send when it is about to do that.
# WATI_TEMPLATE_NAME_MS=
# WATI_TEMPLATE_NAME_ZH=
# WATI_TEMPLATE_NAME_TA=
# WATI_TEMPLATE_NAME_AR=

# Pause between parents during a send, in milliseconds. Google throttles bursts
# and WATI rate-limits; lower this only if you know both are happy.
# EVENT_SEND_DELAY_MS=900
