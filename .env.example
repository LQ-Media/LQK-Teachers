# Copy to .env.local for development, and set these as environment variables
# on your host for production.

# Signing key for the session JWT. REQUIRED in production — the server refuses
# to start signing sessions without it. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Directory for the SQLite database file (lqk.db). In production, point this at
# a mounted persistent volume so data survives restarts/redeploys.
# Local dev can leave this unset (defaults to ./data).
LQK_DATA_DIR=/data

# Shared code that lets someone register with the HQ branch, which grants the
# admin role. Hand it only to HQ staff; anyone else registers as a teacher at a
# teaching branch. If this is unset, HQ sign-up is refused outright rather than
# granted freely — so production MUST set it before HQ staff can sign up.
# There is no rate limiting on the register endpoint, so make it long and random:
#   node -e "console.log(require('node:crypto').randomBytes(12).toString('base64url'))"
LQK_HQ_CODE=

# Google Sheet backend for the Quran tracker (student roster + lessons), via its
# Apps Script web app. Defaults to the existing values if unset, but set these
# in production and rotate the token in the Apps Script (it has been public).
LQK_SHEET_URL=
LQK_SHEET_TOKEN=

# ── Halaqah Notebook (/notebook) ─────────────────────────────────────────────
# Both keys are OPTIONAL. Typed notes work with neither; each feature simply
# shows as "off" in the UI until its key is present. No audio or image is ever
# written to disk — uploads are streamed to the provider and discarded.

# Groq — transcribes recordings (Whisper) and writes the summaries.
# Free tier at time of writing: 2,000 transcriptions and 28,800 audio-seconds
# (8 hours) per day, which comfortably covers a centre of ~40 teachers.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — reads text out of a photographed page. Only needed for the
# "Photo" capture mode; Groq has no production vision model.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides — leave unset to use the free-tier defaults above.
# LQK_AI_TRANSCRIBE_MODEL=whisper-large-v3
# LQK_AI_CHAT_MODEL=llama-3.3-70b-versatile
# LQK_AI_VISION_MODEL=gemini-flash-latest
#   Use the rolling "-latest" alias, not a pinned version. Google retires
#   specific Gemini versions for NEW API keys while still listing them on
#   /v1beta/models, so a pinned name like gemini-2.5-flash returns 404
#   ("no longer available to new users") on a freshly created key.

# ── Event invitations (/events, /i/<token>) ──────────────────────────────────

# Family photos (and any "Photo upload" custom question) are written straight
# into Karim's Drive folder through an Apps Script web app — see the setup steps
# at the top of scripts/drive-upload.gs. WITHOUT BOTH of these the invitation
# still takes replies, but every photo upload is refused: the event editor says
# "Drive not configured" next to the "Ask guests for a family photo" switch, and
# the guest is told the image didn't upload.
#   LQK_DRIVE_URL   — the Apps Script deployment's /exec URL
#   LQK_DRIVE_TOKEN — must equal SHARED_TOKEN in the script's Script Properties
LQK_DRIVE_URL=
LQK_DRIVE_TOKEN=

# Destination folder. Sent on every request and beats the script's own
# FOLDER_ID, so the live destination is changed HERE, not in the Apps Script.
# Also what the event page's "photos" tile links to.
LQK_DRIVE_FOLDER_ID=

# Signing secret for the store's "Order payment" webhook, from the LQK Shopify
# admin (Settings → Notifications → Webhooks). Without it the endpoint answers
# 503, no contribution is ever confirmed, and an attending family that has paid
# can never finish their reply. The event editor warns about this out loud.
SHOPIFY_EVENTS_WEBHOOK_SECRET=

# The storefront the contribution product is read from and checked out on.
# Defaults to https://lqkstore.littlequrankids.sg when unset.
LQK_STORE_ORIGIN=

# ── Peer assessment evidence (Assessments) ──────────────────────────────────
# Video clips and photos an assessor attaches go to Drive through the SAME
# Apps Script as event photos (LQK_DRIVE_URL / LQK_DRIVE_TOKEN above), into
# this folder rather than the events one, under Assessments/<year>/<teacher>.
# Share the folder with admins' Google accounts only. Without it uploads fall
# back to LQK_DRIVE_FOLDER_ID; without Drive at all the upload button explains
# that evidence is not set up and scoring still works.
LQK_ASSESS_DRIVE_FOLDER_ID=

# ── Parents portal bridge (My classes) ──────────────────────────────────────
# The parents portal owns enrolment. "My classes" reads a teacher's classes and
# children from it and sends after-lesson reports back into each child's feed.
#   LQK_PARENTS_URL    https://parents.littlequrankids.sg (no trailing slash)
#   LQK_PARENTS_TOKEN  must equal TEACHERS_API_SECRET on the parents service
# Both unset: the page says the link is not set up, nothing else is affected.
LQK_PARENTS_URL=
LQK_PARENTS_TOKEN=

# ── Social sign-in (Google, Microsoft, Facebook) ────────────────────────────
# All OPTIONAL. A provider appears on the login page only when BOTH its id
# and secret are set; email + password always works. A social sign-in links
# to an existing account only on an exact email match and never sets a role.
#
# Redirect URI to register at each provider (LQK_APP_ORIGIN + this path):
#   https://teachers.littlequrankids.sg/api/auth/google/callback
#   https://teachers.littlequrankids.sg/api/auth/microsoft/callback
#   https://teachers.littlequrankids.sg/api/auth/facebook/callback
#
# The portal's own public origin, no trailing slash. Behind Railway's proxy
# the request reports an internal host, so set this in production.
LQK_APP_ORIGIN=

# Google: console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID (Web application). Add the redirect URI above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: entra.microsoft.com → App registrations → New (Web platform,
# redirect URI above) → Certificates & secrets → new client secret (copy the
# VALUE, not the id). MICROSOFT_TENANT is "common" for any Microsoft account
# or the LQK tenant id to admit work accounts only.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Facebook: developers.facebook.com → app → Facebook Login → Settings → Valid
# OAuth Redirect URIs. Until Meta's app review passes only app testers can
# sign in, and some accounts share no email — those are told to use another
# method.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
